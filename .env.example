# =====================================================================
# Pandecta — variáveis de ambiente
# Copie para ".env" e preencha. NUNCA versione o arquivo .env.
# =====================================================================

# ---------- Backend ----------
SERVER_PORT=8080
# Origens permitidas para o frontend (CORS), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173
# URL pública do frontend (usada para montar o link do login por QR Code)
FRONTEND_PUBLIC_URL=http://localhost:5173

# ---------- OpenSearch / Elasticsearch ----------
# Compatível com OpenSearch 2.x e Elasticsearch 8.x (API REST)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Prefixo dos índices (permite vários ambientes no mesmo cluster)
OPENSEARCH_INDEX_PREFIX=pandecta

# ---------- Firebase (Admin SDK — backend) ----------
# Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json
# Chave de API Web (mesma do frontend). Usada pelo backend para validar senha via Identity Toolkit.
FIREBASE_WEB_API_KEY=
# Domínio interno usado para o e-mail técnico das contas criadas por nome de usuário
AUTH_SYNTHETIC_EMAIL_DOMAIN=usuarios.pandecta.invalid
# UIDs de administradores (podem disparar sincronizações manuais), separados por vírgula
ADMIN_UIDS=

# ---------- Firebase (frontend — Vite) ----------
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- Inteligência artificial (RAG) ----------
# Sem chave, a busca funciona normalmente e o painel de IA informa que está desativado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_SOURCES=14

# ---------- Fontes oficiais ----------
# DataJud (CNJ): chave PÚBLICA publicada na wiki oficial e que o CNJ pode trocar a qualquer momento.
# Obtenha a vigente em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Aliases DataJud sincronizados periodicamente para o Radar (todos ficam disponíveis para consulta por número)
DATAJUD_RADAR_ALIASES=stj,tst,trf1,trf3,trf4,tjsp,tjrj,tjmg
DATAJUD_MAX_PER_RUN=500

# DJEN (comunicaapi.pje.jus.br) — tribunais monitorados no Radar
DJEN_TRIBUNAIS=STJ,TST,TRF1,TRF3,TRF4,TJSP,TJRJ,TJMG,TJRS,TJPR
DJEN_TIPOS_DOCUMENTO=Acórdão,Sentença,Decisão,Ementa
DJEN_MAX_PAGES_PER_TRIBUNAL=5

# STJ — Portal de Dados Abertos (CKAN)
STJ_CKAN_URL=https://dadosabertos.web.stj.jus.br
STJ_DATASET_QUERY=espelhos-de-acordaos
STJ_MAX_RESOURCES_PER_RUN=3

# Agendamentos (cron Spring: seg min hora dia mês dia-semana) — fuso America/Sao_Paulo
SYNC_PLANALTO_CRON=0 30 3 * * *
SYNC_LEXML_CRON=0 0 */6 * * *
SYNC_DJEN_CRON=0 */30 * * * *
SYNC_DATAJUD_CRON=0 15 */2 * * *
SYNC_STJ_CRON=0 0 4 * * *
# Sincronizar tudo ao iniciar (útil na primeira execução)
SYNC_ON_STARTUP=true
# User-Agent identificando a aplicação para as fontes oficiais
CONNECTOR_USER_AGENT=PandectaBot/1.0 (+https://seu-dominio.com.br/sobre-o-robo)
